#!/bin/sh
# blazie-emu-btspeak postinst: the firmware fetched (never fatal: without a network the Braille Lite's item fetches it
# on first start), and every BT Speak user's User Menu given the line that opens the Blazie menu, which lists the
# units each time it opens (user-menu-entry; the three lines a unit each that packages before it wrote go).
# BTE_ROOT and BTE_HOMES: the tests' own.
set -e
ROOT="${BTE_ROOT:-}"
LIB="$ROOT/usr/lib/blazie-emu-btspeak"

case "$1" in
    configure)
        if [ ! -f "$LIB/share/ssi263-speech/BL2ENG.BNS" ]; then
            if "$LIB/fetch-firmware" "$LIB/share/ssi263-speech"; then
                echo "blazie-emu-btspeak: the firmware is fetched"
            else
                rm -rf "$LIB/share/ssi263-speech"
                echo "blazie-emu-btspeak: the firmware could not be fetched now; it will be on first start"
            fi
        fi
        for dir in ${BTE_HOMES:-/home/*}/BTSpeak; do
            [ -d "$dir" ] || continue
            um="$dir/user.menu"
            new=0
            [ -f "$um" ] || new=1
            "$LIB/user-menu-entry" "$um" /usr/lib/blazie-emu-btspeak/blazie.menu \
                "run /usr/bin/blazie-emu-btspeak --unit" 2>/dev/null || true
            [ "$new" = 0 ] || chown --reference="$dir" "$um" 2>/dev/null || true
        done
        ;;
esac
exit 0
